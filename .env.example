# SuryaHimal — Environment Variables Template
# Copy this file to .env and configure your keys.

# Groq LLM API Key (free at https://console.groq.com/)
Groq_API=gsk_your_groq_api_key_here

# Supabase Auth & Storage (optional for evaluator login)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# API URL for Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend Allowed Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
